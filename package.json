{
  "name": "pnl-calc-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js",
    "build:css:scss": "sass public/css/index.scss public/css/index.css",
    "build:css:tailwind": "tailwindcss -i ./public/css/tailwind-input.css -o ./public/css/tailwind.css --minify",
    "build:css": "npm run build:css:scss && npm run build:css:tailwind",
    "watch:css": "sass --watch public/css/index.scss public/css/index.css & tailwindcss -i ./public/css/tailwind-input.css -o ./public/css/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.9",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.0"
  }
}
